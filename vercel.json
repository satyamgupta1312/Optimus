{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/local/index.js": {
      "excludeFiles": "server/uploads/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/local/:path*/", "destination": "/api/local/index.js" },
    { "source": "/api/local/:path*", "destination": "/api/local/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
